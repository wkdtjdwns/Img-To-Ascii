<Window x:Class="ImgToAscii.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image to ASCII Art"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="500"
        Background="#191724"
        WindowStartupLocation="CenterScreen">

    <!-- ======================================================
         리소스 — 앱 전역 스타일 정의 (Rosé Pine 다크 테마)
         색상 팔레트:
           #191724 배경(Base)   #1F1D2E 패널(Surface)
           #26233A 오버레이     #E0DEF4 전경(텍스트)
           #C4A7E7 강조(Iris)   #9CCFD8 보조(Foam)
    ====================================================== -->
    <Window.Resources>

        <!-- 일반 버튼: 둥근 모서리 + 호버/클릭/비활성 상태 트리거 포함 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E0DEF4"/>
            <Setter Property="Background" Value="#26233A"/>
            <Setter Property="BorderBrush" Value="#403D52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- 기본 WPF Button 템플릿을 교체해 CornerRadius 적용 -->
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#403D52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#524F67"/>
                            </Trigger>
                            <!-- 비활성 시 반투명 처리 (IsEnabled=False인 버튼에 자동 적용) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 강조 버튼(▶ 변환): ModernButton을 상속하여 색상만 재정의 -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#C4A7E7"/>
            <Setter Property="Foreground" Value="#191724"/>
            <Setter Property="BorderBrush" Value="#C4A7E7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D7BFF0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#9CCFD8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Label / RadioButton 전경색 일괄 적용 -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0DEF4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0DEF4"/>
        </Style>

    </Window.Resources>

    <!-- 루트 Grid: Row 0 = 툴바(고정), Row 1 = 콘텐츠(확장) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상단 툴바 ──────────────────────────────────────────
             DockPanel 좌측: 앱 타이틀 + 액션 버튼들
             DockPanel 우측: 상태 메시지(TxtStatus) — 코드비하인드에서 갱신
        ─────────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#1F1D2E" BorderBrush="#26233A" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Image → ASCII Art" FontSize="16" FontWeight="Bold"
                               Foreground="#C4A7E7" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <!-- 이미지 열기: 파일 다이얼로그 트리거 -->
                    <Button x:Name="BtnLoadImage" Content="이미지 열기" Style="{StaticResource ModernButton}"
                            Click="BtnLoadImage_Click" Margin="0,0,6,0"/>

                    <!-- 변환: 이미지 로드 전까지 비활성(IsEnabled=False) -->
                    <Button x:Name="BtnConvert" Content="▶ 변환" Style="{StaticResource AccentButton}"
                            Click="BtnConvert_Click" IsEnabled="False" Margin="0,0,6,0"/>

                    <!-- 저장/복사: 변환 완료 후 활성화 -->
                    <Button x:Name="BtnSaveTxt"  Content="TXT 저장"     Style="{StaticResource ModernButton}"
                            Click="BtnSaveTxt_Click"  IsEnabled="False" Margin="0,0,6,0"/>
                    <Button x:Name="BtnSaveHtml" Content="HTML 저장"    Style="{StaticResource ModernButton}"
                            Click="BtnSaveHtml_Click" IsEnabled="False" Margin="0,0,6,0"/>
                    <Button x:Name="BtnCopy"     Content="클립보드 복사" Style="{StaticResource ModernButton}"
                            Click="BtnCopy_Click"     IsEnabled="False"/>
                </StackPanel>

                <!-- 우측 상태 텍스트 — LoadImage/Convert 완료 시 코드비하인드에서 업데이트 -->
                <TextBlock x:Name="TxtStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="#6E6A86" FontSize="11" HorizontalAlignment="Right"
                           Text="이미지를 열거나 드래그 앤 드롭하세요"/>
            </DockPanel>
        </Border>

        <!-- ── 메인 콘텐츠 Grid ──────────────────────────────────
             Col 0: 설정 패널 (고정 220px, 최소 180px)
             Col 1: GridSplitter (드래그로 Col 0 ↔ Col 2 너비 조절)
             Col 2: 원본 이미지 패널 (비율 확장)
             Col 3: GridSplitter (드래그로 Col 2 ↔ Col 4 너비 조절)
             Col 4: ASCII 결과 패널 (비율 확장)
        ─────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 설정 패널 (Col 0) ─────────────────────────── -->
            <Border Grid.Column="0" Background="#1F1D2E" BorderBrush="#26233A" BorderThickness="0,0,1,0" Padding="14">
                <!-- 설정 항목이 많아질 경우를 대비해 ScrollViewer로 감쌈 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="설정" FontSize="14" FontWeight="Bold"
                                   Foreground="#E0DEF4" Margin="0,0,0,16"/>

                        <!-- 출력 너비 슬라이더 + 현재 값 표시 레이블 -->
                        <Label Content="출력 너비" Padding="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <!-- 범위 20~300, 10 단위로 스냅 -->
                            <Slider x:Name="SliderWidth" Grid.Column="0" Minimum="20" Maximum="300"
                                    Value="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="SliderWidth_ValueChanged"/>
                            <!-- 슬라이더 값 미러링 — 코드비하인드 SliderWidth_ValueChanged에서 갱신 -->
                            <TextBlock x:Name="TxtWidthValue" Grid.Column="1" Text="100"
                                       Foreground="#9CCFD8" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FontSize="13" FontWeight="Bold"/>
                        </Grid>

                        <Separator Background="#26233A" Margin="0,12,0,12"/>

                        <!-- 문자셋 선택 — 인덱스가 GetSelectedCharSet() switch 분기와 1:1 대응 -->
                        <Label Content="문자셋" Padding="0,0,0,4"/>
                        <ComboBox x:Name="CmbCharset" Margin="0,0,0,12"
                                  Background="#26233A" Foreground="#29487F" BorderBrush="#0A54FF"
                                  SelectionChanged="CmbCharset_SelectionChanged">
                            <ComboBoxItem Content="기본 ( .,:;i1tfLCG08@)" IsSelected="True"/><!-- index 0 -->
                            <ComboBoxItem Content="단순 (  .:-=+*#%@)"/>                       <!-- index 1 -->
                            <ComboBoxItem Content="블록 ( ░▒▓█)"/>                             <!-- index 2 -->
                        </ComboBox>

                        <Separator Background="#26233A" Margin="0,0,0,12"/>

                        <!-- 출력 모드 선택
                             - 흑백: TXT와 HTML 모두 회색조
                             - 컬러: HTML 파일에만 픽셀 원본 색상 반영 (TXT는 색상 없음) -->
                        <Label Content="출력 모드" Padding="0,0,0,4"/>
                        <RadioButton x:Name="RbGrayscale" Content="흑백 텍스트" IsChecked="True"
                                     Margin="0,0,0,6" GroupName="Mode"/>
                        <RadioButton x:Name="RbColor" Content="컬러 (HTML 전용)"
                                     Margin="0,0,0,12" GroupName="Mode"/>

                        <Separator Background="#26233A" Margin="0,0,0,12"/>

                        <!-- 미리보기 폰트 크기 — ASCII 결과 TextBox에 즉시 반영 -->
                        <Label Content="미리보기 폰트 크기" Padding="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderFontSize" Grid.Column="0" Minimum="4" Maximum="16"
                                    Value="8" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="SliderFontSize_ValueChanged"/>
                            <TextBlock x:Name="TxtFontSizeValue" Grid.Column="1" Text="8"
                                       Foreground="#9CCFD8" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FontSize="13" FontWeight="Bold"/>
                        </Grid>

                        <Separator Background="#26233A" Margin="0,0,0,12"/>

                        <!-- 이미지 정보 — LoadImage에서 파일명/해상도/용량으로 채워짐 -->
                        <TextBlock x:Name="TxtImageInfo" Text="이미지 없음"
                                   Foreground="#6E6A86" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- GridSplitter: Col 0(설정)과 Col 2(이미지) 사이 너비 조절 핸들 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#26233A" Cursor="SizeWE"/>

            <!-- ── 원본 이미지 패널 (Col 2) ──────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 패널 헤더 -->
                    <RowDefinition Height="*"/>     <!-- 이미지 영역 -->
                </Grid.RowDefinitions>

                <!-- 패널 헤더 -->
                <Border Grid.Row="0" Background="#1F1D2E" Padding="10,6"
                        BorderBrush="#26233A" BorderThickness="0,0,0,1">
                    <TextBlock Text="원본 이미지" Foreground="#908CAA" FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <!-- 드롭존: AllowDrop=True로 파일 드래그 앤 드롭 활성화
                     이벤트 3종: DragOver(테두리 강조) / DragLeave(테두리 복구) / Drop(파일 처리) -->
                <Border Grid.Row="1" x:Name="DropZone"
                        Background="#16141F" AllowDrop="True"
                        Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave"
                        BorderBrush="#26233A" BorderThickness="0">
                    <Grid>
                        <!-- 이미지 미로드 상태의 안내 문구 — LoadImage 호출 시 Collapsed로 숨겨짐 -->
                        <StackPanel x:Name="DropHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="이미지를 여기에 드래그 앤 드롭" Foreground="#6E6A86"
                                       FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="또는 [이미지 열기] 버튼 사용" Foreground="#524F67"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 이미지 미리보기 — 이미지 로드 후 Visible로 전환
                             HighQuality: 축소 시 안티에일리어싱 적용 -->
                        <Image x:Name="ImgPreview" Stretch="Uniform" Margin="8"
                               Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- GridSplitter: Col 2(이미지)와 Col 4(ASCII) 사이 너비 조절 핸들 -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="#26233A" Cursor="SizeWE"/>

            <!-- ── ASCII 결과 패널 (Col 4) ────────────────────── -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 패널 헤더 -->
                    <RowDefinition Height="*"/>     <!-- 결과 텍스트 영역 -->
                </Grid.RowDefinitions>

                <!-- 패널 헤더 -->
                <Border Grid.Row="0" Background="#1F1D2E" Padding="10,6"
                        BorderBrush="#26233A" BorderThickness="0,0,0,1">
                    <TextBlock Text="ASCII 아트 결과" Foreground="#908CAA" FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <!-- 결과 영역: 가로/세로 스크롤 모두 허용 (ASCII 아트는 줄 바꿈 없이 표시해야 형태 유지) -->
                <ScrollViewer Grid.Row="1" Background="#16141F"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <!-- IsReadOnly: 사용자가 실수로 결과를 수정하지 못하도록 방지
                         TextWrapping="NoWrap": 줄 바꿈 시 ASCII 아트 형태가 깨지므로 반드시 NoWrap -->
                    <TextBox x:Name="TxtAsciiResult"
                             Background="Transparent" Foreground="#9CCFD8"
                             FontFamily="Courier New" FontSize="8"
                             IsReadOnly="True" BorderThickness="0"
                             TextWrapping="NoWrap" VerticalAlignment="Top"
                             HorizontalAlignment="Left"
                             Padding="8"/>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
